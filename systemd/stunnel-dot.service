[Unit]
Description=EuroDNS DNS-over-TLS (LEGACY: stunnel) — UNUSED
# DoT is now served NATIVELY by eurodns-resolver on :853 (ALPN=dot, real LE cert).
# This unit is kept only for reference; deploy.sh no longer installs it.
After=network-online.target eurodns-resolver.service
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/bin/stunnel /etc/stunnel/eurodns-dot.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
