[Unit]
Description=EuroDNS DNS-over-TLS (DoT) endpoint via stunnel -> resolver:53
After=network-online.target eurodns-resolver.service
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/bin/stunnel /etc/stunnel/eurodns-dot.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
